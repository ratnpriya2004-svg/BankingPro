<div class="container py-5 min-vh-100">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-info text-white text-center py-4">
                    <i class="bi bi-phone fs-1 me-2"></i>
                    <h2>Mobile Recharge</h2>
                    <p class="mb-0">Prepaid • Postpaid • All Operators</p>
                </div>
                <div class="card-body p-5">
                    <form>
                        <div class="mb-4">
                            <label class="form-label fw-bold fs-5">Mobile Number</label>
                            <input type="tel" class="form-control form-control-lg" placeholder="98XXXXXXXX">
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold fs-5">Amount (₹)</label>
                            <input type="number" class="form-control form-control-lg" placeholder="200" step="10">
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold fs-5">Operator</label>
                            <select class="form-select form-select-lg">
                                <option>Jio</option>
                                <option>Airtel</option>
                                <option>Vi</option>
                                <option>BSNL</option>
                            </select>
                        </div>
                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-success btn-lg fw-bold py-3">
                                <i class="bi bi-phone me-2"></i>Recharge Now
                            </button>
                            <a href="/Account/BillPayments" class="btn btn-outline-primary btn-lg py-3">
                                <i class="bi bi-receipt me-2"></i>Other Bills
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
