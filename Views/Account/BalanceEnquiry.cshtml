<div class="bank-bg-overlay"></div>
<div class="container py-5 min-vh-100">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- HEADER -->
            <div class="text-center mb-6">
                <i class="bi bi-wallet2 display-3 text-success mb-4"></i>
                <h1 class="text-white fw-bold fs-1">Balance Enquiry</h1>
                <div class="project-transparent px-5 py-2 d-inline-block fs-5">
                    @ViewBag.AccountNumber
                </div>
            </div>

            <!-- 🔥 4 BALANCE CARDS -->
            <div class="row g-4 mb-6">
                <!-- TOTAL BALANCE -->
                <div class="col-lg-6 col-md-6">
                    <div class="balance-card total-balance">
                        <div class="balance-icon">
                            <i class="bi bi-house-door"></i>
                        </div>
                        <div class="balance-info">
                            <h6 class="text-white-50 mb-1">Total Balance</h6>
                            <div class="balance-amount">₹@ViewBag.TotalBalance?.ToString("N0")</div>
                            <small class="text-success">Available to spend</small>
                        </div>
                    </div>
                </div>

                <!-- SAVINGS -->
                <div class="col-lg-6 col-md-6">
                    <div class="balance-card savings-balance">
                        <div class="balance-icon">
                            <i class="bi bi-piggy-bank"></i>
                        </div>
                        <div class="balance-info">
                            <h6 class="text-white-50 mb-1">Savings Account</h6>
                            <div class="balance-amount">₹@ViewBag.SavingsBalance?.ToString("N0")</div>
                            <small class="text-success">4.5% interest</small>
                        </div>
                    </div>
                </div>

                <!-- FIXED DEPOSIT -->
                <div class="col-lg-6 col-md-6">
                    <div class="balance-card fd-balance">
                        <div class="balance-icon">
                            <i class="bi bi-graph-up"></i>
                        </div>
                        <div class="balance-info">
                            <h6 class="text-white-50 mb-1">Fixed Deposit</h6>
                            <div class="balance-amount">₹@ViewBag.FixedDeposit?.ToString("N0")</div>
                            <small class="text-warning">6.8% interest</small>
                        </div>
                    </div>
                </div>

                <!-- CURRENT -->
                <div class="col-lg-6 col-md-6">
                    <div class="balance-card current-balance">
                        <div class="balance-icon">
                            <i class="bi bi-credit-card-2-front"></i>
                        </div>
                        <div class="balance-info">
                            <h6 class="text-white-50 mb-1">Current Account</h6>
                            <div class="balance-amount">₹0</div>
                            <small class="text-muted">No limit</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- QUICK ACTIONS -->
            <div class="row g-3">
                <div class="col-md-4">
                    <a href="#" class="quick-action-btn deposit-btn">
                        <i class="bi bi-arrow-up-circle"></i> Deposit
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="#" class="quick-action-btn withdraw-btn">
                        <i class="bi bi-arrow-down-circle"></i> Withdraw
                    </a>
                </div>
                <div class="col-md-4">
                    <a href="/Account/Dashboard" class="quick-action-btn dashboard-btn">
                        <i class="bi bi-house-door"></i> Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* 🔥 PROFESSIONAL BALANCE CARDS */
    .balance-card {
        backdrop-filter: blur(25px);
        background: rgba(255,255,255,0.12);
        border: 1px solid rgba(255,255,255,0.2);
        border-radius: 24px;
        padding: 2.5rem;
        display: flex;
        align-items: center;
        height: 140px;
        transition: all 0.4s ease;
        box-shadow: 0 20px 60px rgba(0,0,0,0.25);
        position: relative;
        overflow: hidden;
    }

        .balance-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
        }

        .balance-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 30px 80px rgba(0,0,0,0.4);
        }

    .total-balance::before {
        background: linear-gradient(90deg, #10b981, #34d399);
    }

    .savings-balance::before {
        background: linear-gradient(90deg, #3b82f6, #60a5fa);
    }

    .fd-balance::before {
        background: linear-gradient(90deg, #f59e0b, #fbbf24);
    }

    .current-balance::before {
        background: linear-gradient(90deg, #6b7280, #9ca3af);
    }

    .balance-icon {
        width: 80px;
        height: 80px;
        border-radius: 20px;
        backdrop-filter: blur(20px);
        margin-right: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
    }

    .total-balance .balance-icon {
        background: rgba(16,185,129,0.3);
        color: #10b981;
    }

    .savings-balance .balance-icon {
        background: rgba(59,130,246,0.3);
        color: #3b82f6;
    }

    .fd-balance .balance-icon {
        background: rgba(245,158,11,0.3);
        color: #f59e0b;
    }

    .current-balance .balance-icon {
        background: rgba(107,114,128,0.3);
        color: #6b7280;
    }

    .balance-amount {
        font-size: 2.2rem;
        font-weight: 900;
        margin-bottom: 0.5rem;
        background: linear-gradient(135deg, #ffffff, #f8fafc);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .quick-action-btn {
        display: block;
        text-decoration: none;
        padding: 1.5rem 2rem;
        border-radius: 20px;
        text-align: center;
        font-weight: 700;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        border: 2px solid rgba(255,255,255,0.3);
        backdrop-filter: blur(20px);
        color: white;
    }

        .quick-action-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.3);
            text-decoration: none;
            color: white;
        }

    .deposit-btn {
        background: rgba(16,185,129,0.2);
        border-color: #10b981;
    }

    .withdraw-btn {
        background: rgba(239,68,68,0.2);
        border-color: #ef4444;
    }

    .dashboard-btn {
        background: rgba(59,130,246,0.2);
        border-color: #3b82f6;
    }
</style>
