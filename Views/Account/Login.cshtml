<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4" style="backdrop-filter: blur(20px); background: rgba(255,255,255,0.9);">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <i class="bi bi-shield-lock fs-1 text-primary mb-3"></i>
                        <h2 class="fw-bold text-dark">Secure Login</h2>
                        <p class="text-muted">Enter your registered email & password</p>
                    </div>

                    @if(TempData["Error"] != null)
                    {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    <form asp-action="Login" method="post">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Email</label>
                            <input type="email" name="email" class="form-control form-control-lg rounded-3" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Password</label>
                            <input type="password" name="password" class="form-control form-control-lg rounded-3" required>
                        </div>
                        <button type="submit" class="btn btn-primary btn-lg w-100 py-3">Login</button>
                    </form>

                    <div class="text-center mt-4">
                        <p>New user? <a asp-action="Register" class="text-primary fw-bold">Create Account</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
