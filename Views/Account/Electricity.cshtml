<div class="container py-5 min-vh-100">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-warning text-dark text-center py-4">
                    <i class="bi bi-lightning-charge fs-1 me-2"></i>
                    <h2>Electricity Bill Payment</h2>
                    <p class="mb-0">BSES • TPDDL • MSEDCL • Instant Payment</p>
                </div>
                <div class="card-body p-5">
                    <form>
                        <div class="mb-4">
                            <label class="form-label fw-bold fs-5">Consumer Number</label>
                            <input type="text" class="form-control form-control-lg" placeholder="123456789012">
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold fs-5">Amount (₹)</label>
                            <input type="number" class="form-control form-control-lg" placeholder="2500" step="0.01">
                        </div>
                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-success btn-lg fw-bold py-3">
                                <i class="bi bi-lightning-charge me-2"></i>Pay Now ₹2500
                            </button>
                            <a href="/Account/BillPayments" class="btn btn-outline-primary btn-lg py-3">
                                <i class="bi bi-receipt me-2"></i>Other Bills
                            </a>
                            <a href="/Account/Dashboard" class="btn btn-outline-secondary btn-lg py-3">
                                <i class="bi bi-house me-2"></i>Dashboard
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
