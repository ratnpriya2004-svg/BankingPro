<div class="bank-bg-overlay"></div>
<div class="container py-5 min-vh-100">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- HEADER -->
            <div class="text-center mb-6">
                <i class="bi bi-qr-code display-3 text-teal mb-4"></i>
                <h1 class="text-white fw-bold fs-1">UPI Payments</h1>
                <div class="project-transparent px-4 py-2 d-inline-block fs-5">
                    Instant & Secure
                </div>
            </div>

            <!-- UPI QR CODE -->
            <div class="text-center mb-6">
                <div class="upi-qr-container mx-auto mb-4">
                    <div class="qr-placeholder">
                        <i class="bi bi-qr-code-scan fs-1"></i>
                        <div class="mt-3">yourupi@bankingpro</div>
                    </div>
                </div>
                <div class="project-transparent px-5 py-3 d-inline-block">
                    <strong>@ViewBag.UpiId</strong>
                </div>
            </div>

            <!-- UPI QUICK LINKS -->
            <div class="row g-4 mb-6">
                <div class="col-md-6">
                    <a href="#" class="upi-action-card payto-card">
                        <i class="bi bi-arrow-right-circle"></i>
                        <h5>Pay to UPI ID</h5>
                        <p>Send money instantly</p>
                    </a>
                </div>
                <div class="col-md-6">
                    <a href="#" class="upi-action-card collect-card">
                        <i class="bi bi-arrow-left-circle"></i>
                        <h5>Collect Money</h5>
                        <p>Request payment</p>
                    </a>
                </div>
                <div class="col-md-6">
                    <a href="#" class="upi-action-card scan-card">
                        <i class="bi bi-camera"></i>
                        <h5>Scan & Pay</h5>
                        <p>Camera scan QR</p>
                    </a>
                </div>
                <div class="col-md-6">
                    <a href="#" class="upi-action-card history-card">
                        <i class="bi bi-clock-history"></i>
                        <h5>Transaction History</h5>
                        <p>View past payments</p>
                    </a>
                </div>
            </div>

            <div class="text-center">
                <a href="/Account/Dashboard" class="btn btn-outline-light btn-lg px-5 py-3">
                    <i class="bi bi-house-door me-2"></i>Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .upi-qr-container {
        max-width: 300px;
    }

    .qr-placeholder {
        width: 250px;
        height: 250px;
        border: 3px solid rgba(255,255,255,0.3);
        border-radius: 20px;
        backdrop-filter: blur(20px);
        background: rgba(255,255,255,0.1);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
        color: white;
    }

    .upi-action-card {
        display: flex;
        align-items: center;
        padding: 2.5rem 2rem;
        border-radius: 24px;
        backdrop-filter: blur(25px);
        background: rgba(255,255,255,0.12);
        text-decoration: none;
        color: white;
        border: 1px solid rgba(255,255,255,0.25);
        height: 120px;
        transition: all 0.4s ease;
        box-shadow: 0 20px 60px rgba(0,0,0,0.25);
    }

        .upi-action-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 30px 80px rgba(0,0,0,0.4);
            text-decoration: none;
            color: white;
        }

        .upi-action-card i {
            font-size: 2.5rem;
            margin-right: 1.5rem;
            width: 60px;
        }

    .payto-card {
        border-top: 4px solid #10b981;
    }

    .collect-card {
        border-top: 4px solid #f59e0b;
    }

    .scan-card {
        border-top: 4px solid #3b82f6;
    }

    .history-card {
        border-top: 4px solid #ec4899;
    }
</style>
