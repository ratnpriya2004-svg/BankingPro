<div class="container py-5 min-vh-100">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-6">
            <div class="text-center mb-5">
                <div class="profile-avatar mb-4 mx-auto">
                    <i class="bi bi-person-circle display-1 text-primary"></i>
                </div>
                <div class="transparent-card p-4 mb-4">
                    <h1 class="fw-bold text-black mb-1">@ViewBag.UserName</h1>
                    <div class="project-transparent d-inline-block px-3 py-1 mb-2">BCA Sem 5 Student</div>
                    <p class="text-black-50 lead mb-0">Premium Banking Customer</p>
                </div>
            </div>

            <div class="row g-4 mb-5">
                <div class="col-12">
                    <div class="transparent-card p-5">
                        <h4 class="text-black mb-4"><i class="bi bi-person-badge me-2 text-primary"></i>Personal Information</h4>
                        <div class="row g-4">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="profile-icon me-3"><i class="bi bi-person"></i></div>
                                    <div>
                                        <label class="text-black-50 small">Full Name</label>
                                        <div class="h6 text-black fw-bold">@ViewBag.UserName</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="profile-icon me-3"><i class="bi bi-envelope"></i></div>
                                    <div>
                                        <label class="text-black-50 small">Email</label>
                                        <div class="h6 text-black fw-bold">@ViewBag.Email</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex align-items-center mb-3">
                                    <div class="profile-icon me-3"><i class="bi bi-credit-card"></i></div>
                                    <div>
                                        <label class="text-black-50 small">Account Number</label>
                                        <div class="h6 text-black fw-bold">@ViewBag.AccountNumber</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center">
                <a href="/Account/Dashboard" class="btn btn-outline-light btn-lg py-3 fw-bold">
                    <i class="bi bi-house-door me-2"></i>Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<style>
    .profile-avatar {
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 5px solid rgba(255,255,255,0.2);
        box-shadow: 0 20px 40px rgba(79,70,229,0.3);
    }

    .profile-icon {
        width: 50px;
        height: 50px;
        background: rgba(255,255,255,0.1);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4f46e5;
        font-size: 1.2rem;
    }
</style>
