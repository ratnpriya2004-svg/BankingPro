<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4" style="backdrop-filter: blur(20px); background: rgba(255,255,255,0.9);">
                <div class="card-body p-5">
                    <div class="text-center mb-5">
                        <i class="bi bi-person-plus fs-1 text-success mb-3"></i>
                        <h2 class="fw-bold text-dark">Create Account</h2>
                        <p class="text-muted">Join BankingPro today</p>
                    </div>

                    @if(TempData["Error"] != null)
                    {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                    }
                    @if(TempData["Success"] != null)
                    {
                    <div class="alert alert-success">@TempData["Success"]</div>
                    }

                    <form asp-action="Register" method="post">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Your Email</label>
                            <input type="email" name="email" class="form-control form-control-lg rounded-3" required>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold">Password</label>
                            <input type="password" name="password" class="form-control form-control-lg rounded-3" required minlength="6">
                        </div>
                        <button type="submit" class="btn btn-success btn-lg w-100 py-3">Create Account</button>
                    </form>

                    <div class="text-center mt-4">
                        <p>Already registered? <a asp-action="Login" class="text-primary fw-bold">Login Here</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
