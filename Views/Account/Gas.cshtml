<div class="container-fluid py-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- HEADER -->
            <div class="text-center mb-5">
                <div class="solid-btn p-5 mb-4 mx-auto" style="max-width: 500px; background: linear-gradient(135deg, #f59e0b, #d97706);">
                    <i class="bi bi-fire fs-1 mb-3"></i>
                    <h2 class="fw-bold text-black mb-2">🔥 LPG Gas Cylinder</h2>
                    <small class="text-black-50">Indane • HP Gas • Bharat Gas</small>
                </div>
            </div>

            <!-- FORM -->
            <div class="transparent-card p-5">
                <form asp-action="GasBill" method="post">
                    <div class="mb-4">
                        <label class="form-label fw-bold text-black fs-5 mb-3">Customer ID</label>
                        <div class="input-group">
                            <span class="input-group-text bg-warning bg-opacity-20">
                                <i class="bi bi-gas-pump"></i>
                            </span>
                            <input name="customerId" class="form-control bg-transparent text-black"
                                   placeholder="Enter 17-digit Customer ID" required>
                            <button type="button" class="btn btn-outline-warning">
                                <i class="bi bi-search"></i> Check
                            </button>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-black fs-5 mb-3">Cylinder Type</label>
                        <select name="cylinderType" class="form-select bg-transparent text-black">
                            <option>14.2 KG Domestic</option>
                            <option>19 KG Commercial</option>
                            <option>5 KG POM</option>
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold text-black fs-5 mb-3">Amount</label>
                        <div class="input-group">
                            <span class="input-group-text bg-success bg-opacity-20 fs-5">₹</span>
                            <input name="amount" type="number" class="form-control bg-transparent text-black fs-4 text-end"
                                   placeholder="945" required>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold py-4 fs-4 mb-4">
                        <i class="bi bi-credit-card me-2"></i>Book Gas Cylinder
                    </button>

                    <a href="/Account/BillPayments" class="btn btn-outline-light w-100 py-3">
                        <i class="bi bi-arrow-left me-2"></i>← Back to Bills
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>
