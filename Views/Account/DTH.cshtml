<div class="container py-5 min-vh-100">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger text-white text-center py-4">
                    <i class="bi bi-tv fs-1 me-2"></i>
                    <h2>DTH Recharge</h2>
                    <p class="mb-0">Tata Sky • Airtel • Sun Direct • Dish TV</p>
                </div>
                <div class="card-body p-5">
                    <form>
                        <div class="mb-4">
                            <label class="form-label fw-bold fs-5">Subscriber ID</label>
                            <input type="text" class="form-control form-control-lg" placeholder="12345678">
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold fs-5">Amount (₹)</label>
                            <input type="number" class="form-control form-control-lg" placeholder="300" step="50">
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold fs-5">Provider</label>
                            <select class="form-select form-select-lg">
                                <option>Tata Sky</option>
                                <option>Airtel Digital TV</option>
                                <option>Sun Direct</option>
                                <option>Dish TV</option>
                            </select>
                        </div>
                        <div class="d-grid gap-3">
                            <button type="submit" class="btn btn-success btn-lg fw-bold py-3">
                                <i class="bi bi-tv me-2"></i>Recharge Now
                            </button>
                            <a href="/Account/BillPayments" class="btn btn-outline-primary btn-lg py-3">
                                <i class="bi bi-receipt me-2"></i>Other Bills
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
